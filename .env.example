# Optional Development overrides. Docker Compose works without copying this
# file. Jwt__LifetimeMinutes, when supplied, must be exactly 15.
#
# The signing key remains empty here intentionally. If supplied, use Base64 for
# at least 32 random bytes, keep it outside Git and never print it in logs.
Jwt__Issuer=
Jwt__Audience=
Jwt__LifetimeMinutes=
Jwt__SigningKey=

# Optional host output directory used only by the mutation-tests profile.
MUTATION_ARTIFACTS_DIR=
